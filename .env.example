# Copiá este archivo como .env para desarrollo local, o cargá estas mismas
# variables en el panel de "Variables" de Railway para producción.

# Generá una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-esto-por-una-clave-secreta-real

DEBUG=False

# Dominios permitidos, separados por coma (sin https://)
ALLOWED_HOSTS=localhost,127.0.0.1

# Railway completa esta automáticamente, no hace falta cargarla a mano
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre_db

# Fotos: en producción usamos Cloudinary (subir False solo en desarrollo local)
USE_CLOUDINARY=True
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

WHATSAPP_NUMERO=5492216379409
INSTAGRAM_USUARIO=gys__automotores
